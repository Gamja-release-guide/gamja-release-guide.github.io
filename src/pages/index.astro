  title="Release Guard"
  description="Drop-in GitHub Actions workflows that automatically check every PR for security vulnerabilities, code quality issues, and operational risks. 40+ checks, pure bash, free."
>
  <Header />
  <main>
    <Hero />
    <Installation />
    <Features />
    <Playground />
    <Roadmap />
  </main>
  <Footer />
</Base>
