---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="404 - Page Not Found | Release Guard"
  description="The page you're looking for doesn't exist."
  locale="en"
>
  <Header locale="en" />
  <main class="error-page">
    <div class="error-inner">
      <div class="error-terminal">
        <div class="terminal-bar">
          <span class="terminal-dot" style="background:#F47067"></span>
          <span class="terminal-dot" style="background:#D4A03A"></span>
          <span class="terminal-dot" style="background:#3FB86A"></span>
          <span class="terminal-title">release-guard</span>
        </div>
        <div class="terminal-body">
          <div class="terminal-line">
            <span class="t-prompt">$</span>
            <span class="t-cmd">release-guard check --page</span>
          </div>
          <div class="terminal-line">
            <span class="t-crit">CRIT</span>
            <span class="t-text">page-not-found</span>
            <span class="t-desc">The requested page does not exist</span>
          </div>
          <div class="terminal-line">
            <span class="t-info">INFO</span>
            <span class="t-text">suggestion</span>
            <span class="t-desc">Check the URL or return to the homepage</span>
          </div>
          <div class="terminal-line result-line">
            <span class="t-result">1 critical</span>
            <span class="t-sep">|</span>
            <span class="t-result t-result-info">1 info</span>
          </div>
        </div>
      </div>
      <h1 class="error-code">404</h1>
      <p class="error-message">This page couldn't be found.</p>
      <div class="error-actions">
        <a href="/" class="btn-primary">Go Home</a>
        <a href="/#install" class="btn-secondary">Get Started</a>
      </div>
    </div>
  </main>
  <Footer locale="en" />
</Base>

<style>
  .error-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding: 80px 24px;
  }

  .error-inner {
    text-align: center;
    max-width: 560px;
  }

  .error-terminal {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    text-align: left;
    margin-bottom: 32px;
    box-shadow: var(--shadow-md);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: var(--surface);
    border-bottom: 1px solid var(--border-light);
  }

  .terminal-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .terminal-title {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  .terminal-body {
    padding: 16px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.8;
  }

  .terminal-line {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .t-prompt {
    color: var(--text-faint);
  }

  .t-cmd {
    color: var(--accent);
    font-weight: 500;
  }

  .t-crit {
    background: var(--critical-bg);
    color: var(--critical);
    padding: 1px 6px;
    border-radius: 3px;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .t-info {
    background: var(--info-bg);
    color: var(--info);
    padding: 1px 6px;
    border-radius: 3px;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .t-text {
    color: var(--text);
    font-weight: 500;
  }

  .t-desc {
    color: var(--text-muted);
  }

  .result-line {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid var(--border-light);
  }

  .t-result {
    color: var(--critical);
    font-weight: 600;
    font-size: 0.78rem;
  }

  .t-result-info {
    color: var(--info);
  }

  .t-sep {
    color: var(--text-faint);
  }

  .error-code {
    font-family: 'DM Sans', var(--font-sans);
    font-size: 4rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    color: var(--text);
    margin-bottom: 8px;
    line-height: 1;
  }

  .error-message {
    font-size: 1.1rem;
    color: var(--text-muted);
    margin-bottom: 28px;
  }

  .error-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 10px 24px;
    background: var(--accent);
    color: #fff;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.9rem;
    transition: background 0.15s;
    text-decoration: none;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    text-decoration: none;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 10px 24px;
    background: var(--bg-elevated);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.9rem;
    transition: background 0.15s;
    text-decoration: none;
  }

  .btn-secondary:hover {
    background: var(--surface);
    text-decoration: none;
  }

  @media (max-width: 600px) {
    .error-page { padding: 48px 20px; }
    .error-code { font-size: 3rem; }
    .terminal-body { font-size: 0.75rem; }
  }
</style>
