---
import { categories, totalChecks } from '../data/checks';
import type { Locale } from '../i18n/translations';
import { t } from '../i18n/translations';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? 'en';
const i = t(locale);
---

<section id="features" class="features fade-in-section">
  <div class="features-inner">
    <h2 class="section-title">{totalChecks} {i.features.desc}</h2>
    <p class="section-desc">{locale === 'ko'
      ? 'PR diff만 분석합니다 -- 빠르고, 정확하고, 노이즈 없이. 결과는 심각도와 수정 방법과 함께 PR 코멘트로 게시됩니다.'
      : 'Every check runs on the PR diff only -- fast, focused, and noise-free. Results post as PR comments with severity levels and actionable fixes.'
    }</p>

    <div class="severity-bar">
      <span class="sev sev-pass">PASS</span>
      <span class="sev sev-info">INFO</span>
      <span class="sev sev-warn">WARN</span>
      <span class="sev sev-crit">CRITICAL</span>
    </div>

    <div class="cat-grid">
      {categories.map((cat, idx) => (
        <details class="cat-card" open={idx === 0}>
          <summary class="cat-card-header">
            <span class="cat-card-name"><span class="cat-icon" aria-hidden="true">{cat.icon}</span>{cat.name}</span>
            <span class="cat-card-right">
              <span class="cat-card-count">{cat.count}</span>
              <svg class="cat-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </span>
          </summary>
          <ul class="cat-card-list">
            {cat.checks.map((check) => (
              <li>
                <span class="check-name">{check.name}</span>
                <span class="check-desc">{check.description}</span>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </div>

    <div class="lang-support">
      <h3>{i.features.languageTitle}</h3>
      <p>{i.features.languageDesc} JavaScript, TypeScript, Python, Go, Java, Ruby, PHP, Rust, Shell. Template engines: EJS, ERB, Handlebars, Pug, Vue, Svelte.</p>
    </div>
  </div>
</section>

<style>
  .features {
    padding: 80px 24px;
    background: var(--surface);
  }

  .features-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .section-title {
    font-family: 'DM Sans', var(--font-sans);
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
    color: var(--text);
  }

  .section-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 24px;
    max-width: 600px;
  }

  .severity-bar {
    display: flex;
    gap: 8px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .sev {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    letter-spacing: 0.04em;
  }

  .sev-pass { background: var(--pass-bg); color: var(--pass); }
  .sev-info { background: var(--info-bg); color: var(--info); }
  .sev-warn { background: var(--warn-bg); color: var(--warn); }
  .sev-crit { background: var(--critical-bg); color: var(--critical); }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
    margin-bottom: 40px;
  }

  .cat-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .cat-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border-light);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .cat-card-header::-webkit-details-marker {
    display: none;
  }

  .cat-card-header::marker {
    content: '';
  }

  .cat-card-right {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .cat-chevron {
    color: var(--text-faint);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .cat-card[open] .cat-chevron {
    transform: rotate(180deg);
  }

  .cat-card:not([open]) .cat-card-header {
    border-bottom: none;
  }

  .cat-card-name {
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .cat-icon {
    font-size: 0.92rem;
  }

  .cat-card-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    background: var(--surface);
    padding: 2px 8px;
    border-radius: 10px;
  }

  .cat-card-list {
    list-style: none;
    padding: 8px 16px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cat-card-list li {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .check-name {
    font-weight: 500;
    font-size: 0.82rem;
    color: var(--text);
  }

  .check-desc {
    font-size: 0.75rem;
    color: var(--text-faint);
    line-height: 1.4;
  }

  .lang-support {
    padding: 20px 24px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .lang-support h3 {
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 6px;
    color: var(--text);
  }

  .lang-support p {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
  }

  @media (max-width: 600px) {
    .features { padding: 48px 20px; }
    .cat-grid { grid-template-columns: 1fr; }
  }
</style>
