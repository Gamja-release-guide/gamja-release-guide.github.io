---
import { categories, totalChecks } from '../data/checks';
---

<section id="features" class="features">
  <div class="features-inner">
    <h2 class="section-title">{totalChecks} checks across {categories.length} categories</h2>
    <p class="section-desc">Every check runs on the PR diff only -- fast, focused, and noise-free. Results post as PR comments with severity levels and actionable fixes.</p>

    <div class="severity-bar">
      <span class="sev sev-pass">PASS</span>
      <span class="sev sev-info">INFO</span>
      <span class="sev sev-warn">WARN</span>
      <span class="sev sev-crit">CRITICAL</span>
    </div>

    <div class="cat-grid">
      {categories.map((cat) => (
        <div class="cat-card">
          <div class="cat-card-header">
            <span class="cat-card-name">{cat.name}</span>
            <span class="cat-card-count">{cat.count}</span>
          </div>
          <ul class="cat-card-list">
            {cat.checks.map((check) => (
              <li>
                <span class="check-name">{check.name}</span>
                <span class="check-desc">{check.description}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="lang-support">
      <h3>Language Support</h3>
      <p>JavaScript, TypeScript, Python, Go, Java, Ruby, PHP, Rust, Shell. Template engines: EJS, ERB, Handlebars, Pug, Vue, Svelte.</p>
    </div>
  </div>
</section>

<style>
  .features {
    padding: 80px 24px;
    background: var(--surface);
  }

  .features-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .section-title {
    font-family: 'DM Sans', var(--font-sans);
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
    color: var(--text);
  }

  .section-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 24px;
    max-width: 600px;
  }

  .severity-bar {
    display: flex;
    gap: 8px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .sev {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    letter-spacing: 0.04em;
  }

  .sev-pass { background: var(--pass-bg); color: var(--pass); }
  .sev-info { background: var(--info-bg); color: var(--info); }
  .sev-warn { background: var(--warn-bg); color: var(--warn); }
  .sev-crit { background: var(--critical-bg); color: var(--critical); }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
    margin-bottom: 40px;
  }

  .cat-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .cat-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border-light);
  }

  .cat-card-name {
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--text);
  }

  .cat-card-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    background: var(--surface);
    padding: 2px 8px;
    border-radius: 10px;
  }

  .cat-card-list {
    list-style: none;
    padding: 8px 16px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cat-card-list li {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .check-name {
    font-weight: 500;
    font-size: 0.82rem;
    color: var(--text);
  }

  .check-desc {
    font-size: 0.75rem;
    color: var(--text-faint);
    line-height: 1.4;
  }

  .lang-support {
    padding: 20px 24px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .lang-support h3 {
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 6px;
    color: var(--text);
  }

  .lang-support p {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
  }

  @media (max-width: 600px) {
    .features { padding: 48px 20px; }
    .cat-grid { grid-template-columns: 1fr; }
  }
</style>
