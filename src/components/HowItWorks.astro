---
import type { Locale } from '../i18n/translations';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? 'en';
const isKo = locale === 'ko';

const steps = [
  {
    num: '1',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 00-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 004 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>`,
    title: isKo ? 'PR 열기' : 'Open a PR',
    desc: isKo ? '평소처럼 Pull Request를 생성합니다.' : 'Create a Pull Request as you normally do.',
  },
  {
    num: '2',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M12 6v6l4 2"/></svg>`,
    title: isKo ? '자동 검사 실행' : 'Checks run automatically',
    desc: isKo ? 'GitHub Actions가 40개 이상의 보안/품질 체크를 자동으로 실행합니다.' : 'GitHub Actions runs 40+ security and quality checks on the diff.',
  },
  {
    num: '3',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>`,
    title: isKo ? '결과 코멘트' : 'Results as comments',
    desc: isKo ? '심각도별로 그룹화된 체크 결과가 PR 코멘트로 게시됩니다.' : 'Check results post as PR comments grouped by severity.',
  },
  {
    num: '4',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`,
    title: isKo ? '안전하게 머지' : 'Merge with confidence',
    desc: isKo ? '문제가 없으면 안심하고 머지. 문제가 있으면 수정 가이드를 참고합니다.' : 'No issues? Merge safely. Found something? Follow the fix guide.',
  },
];
---

<section class="how-it-works fade-in-section">
  <div class="how-inner">
    <h2 class="section-title">{isKo ? '동작 방식' : 'How it works'}</h2>
    <p class="section-desc">{isKo ? '설정 한 번이면 모든 PR에서 자동으로 실행됩니다.' : 'Set it up once, and it runs on every PR automatically.'}</p>
    <div class="flow-steps">
      {steps.map((step, idx) => (
        <div class="flow-step">
          <div class="step-icon" set:html={step.icon} />
          <div class="step-content">
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.desc}</p>
          </div>
          {idx < steps.length - 1 && (
            <div class="step-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .how-it-works {
    padding: 80px 24px 40px;
  }

  .how-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .section-title {
    font-family: 'DM Sans', var(--font-sans);
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
    color: var(--text);
  }

  .section-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 40px;
    max-width: 560px;
  }

  .flow-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    position: relative;
  }

  .flow-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    padding: 0 12px;
    opacity: 0;
    transform: translateY(14px);
  }

  .flow-steps.is-visible .flow-step {
    animation: step-stagger 0.4s ease forwards;
  }

  .flow-steps.is-visible .flow-step:nth-child(1) { animation-delay: 0s; }
  .flow-steps.is-visible .flow-step:nth-child(2) { animation-delay: 0.1s; }
  .flow-steps.is-visible .flow-step:nth-child(3) { animation-delay: 0.2s; }
  .flow-steps.is-visible .flow-step:nth-child(4) { animation-delay: 0.3s; }

  @keyframes step-stagger {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .step-icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: var(--accent-light);
    color: var(--accent);
    margin-bottom: 16px;
    flex-shrink: 0;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .flow-step:hover .step-icon {
    transform: scale(1.08);
    box-shadow: 0 4px 12px rgba(45, 91, 227, 0.15);
  }

  .step-title {
    font-weight: 700;
    font-size: 0.92rem;
    margin-bottom: 6px;
    color: var(--text);
  }

  .step-desc {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .step-arrow {
    position: absolute;
    right: -10px;
    top: 18px;
    color: var(--text-faint);
  }

  .flow-step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 28px;
    left: calc(50% + 36px);
    right: -8px;
    height: 1px;
    border-top: 2px dashed var(--border);
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-step {
      opacity: 1;
      transform: none;
    }
    .flow-steps.is-visible .flow-step {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    .flow-steps {
      grid-template-columns: 1fr 1fr;
      gap: 28px 16px;
    }

    .step-arrow {
      display: none;
    }

    .flow-step::after {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .how-it-works { padding: 48px 20px 24px; }
    .flow-steps {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .flow-step {
      flex-direction: row;
      text-align: left;
      gap: 16px;
      padding: 0;
    }
    .step-icon {
      margin-bottom: 0;
    }
  }
</style>

<script>
  const flowSteps = document.querySelector('.flow-steps');
  if (flowSteps && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    observer.observe(flowSteps);
  } else if (flowSteps) {
    flowSteps.classList.add('is-visible');
  }
</script>
