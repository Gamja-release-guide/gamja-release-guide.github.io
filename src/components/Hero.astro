---
import type { Locale } from '../i18n/translations';
import { t } from '../i18n/translations';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? 'en';
const i = t(locale);
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-badge">{i.hero.badge}</div>
    <h1 class="hero-title">
      {i.hero.title}<br /><span class="hero-title-accent">{i.hero.titleBreak}</span>
    </h1>
    <p class="hero-desc">{i.hero.desc}</p>
    <div class="hero-actions">
      <a href="#install" class="btn btn-primary">{i.hero.cta}</a>
      <a href="#playground" class="btn btn-secondary">{i.hero.ctaSecondary}</a>
    </div>
    <div class="hero-meta">
      <a href="https://github.com/Gamja-release-guide/release-guard" target="_blank" rel="noopener" class="gh-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        {locale === 'ko' ? 'GitHub에서 보기' : 'View on GitHub'}
      </a>
      <span class="meta-sep">|</span>
      <span class="meta-item">MIT License</span>
      <span class="meta-sep">|</span>
      <span class="meta-item">40+ checks</span>
    </div>
    <div class="hero-terminal">
      <div class="terminal-bar">
        <span class="terminal-dot"></span>
        <span class="terminal-dot"></span>
        <span class="terminal-dot"></span>
        <span class="terminal-title">{i.hero.terminalTitle}</span>
      </div>
      <div class="terminal-body" id="hero-terminal">
        <div class="term-line" data-delay="0"><span class="t-comment">{i.hero.terminalComment1}</span></div>
        <div class="term-line" data-delay="300"><span class="t-pass">PASS</span>  secret-scan         No secrets detected</div>
        <div class="term-line" data-delay="500"><span class="t-pass">PASS</span>  sql-injection       No injection patterns found</div>
        <div class="term-line" data-delay="700"><span class="t-warn">WARN</span>  pr-size-check       PR is Large (487 lines)</div>
        <div class="term-line" data-delay="900"><span class="t-warn">WARN</span>  complexity-check    2 files exceed nesting depth 4</div>
        <div class="term-line" data-delay="1100"><span class="t-crit">CRIT</span>  xss-check           dangerouslySetInnerHTML in UserCard.tsx:42</div>
        <div class="term-line" data-delay="1300"><span class="t-pass">PASS</span>  lockfile-check      package-lock.json in sync</div>
        <div class="term-line" data-delay="1500"><span class="t-info">INFO</span>  todo-fixme-check    3 new TODO markers added</div>
        <div class="term-line" data-delay="1700"><span class="t-pass">PASS</span>  encoding-check      All files UTF-8, consistent line endings</div>
        <div class="term-line" data-delay="2000"><span class="t-comment">{i.hero.terminalComment2}</span></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 80px 24px 64px;
    text-align: center;
  }

  .hero-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--accent);
    background: var(--accent-light);
    padding: 5px 14px;
    border-radius: 20px;
    letter-spacing: 0.02em;
    margin-bottom: 24px;
  }

  .hero-title {
    font-family: 'DM Sans', var(--font-sans);
    font-weight: 700;
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-wrap: balance;
    margin-bottom: 20px;
    color: var(--text);
  }

  .hero-title-accent {
    background: linear-gradient(135deg, var(--accent), #8b5cf6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 560px;
    margin: 0 auto 32px;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 48px;
    font-size: 0.8rem;
    color: var(--text-faint);
    flex-wrap: wrap;
  }

  .gh-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
  }

  .gh-link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .meta-sep {
    color: var(--border);
  }

  .meta-item {
    font-weight: 500;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 10px 24px;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s, color 0.15s, box-shadow 0.15s;
  }

  .btn-primary {
    background: var(--accent);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    text-decoration: none;
  }

  .btn-secondary {
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
  }

  .btn-secondary:hover {
    background: var(--border-light);
    text-decoration: none;
  }

  .hero-terminal {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    text-align: left;
    box-shadow: var(--shadow-md);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: var(--surface);
    border-bottom: 1px solid var(--border-light);
  }

  .terminal-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border);
  }

  .terminal-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    margin-left: 8px;
  }

  .terminal-body {
    padding: 18px 20px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.8;
    color: var(--text-muted);
    margin: 0;
  }

  .terminal-body code {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .term-line {
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    white-space: pre;
  }

  .term-line.is-typed {
    opacity: 1;
    transform: translateY(0);
  }

  .t-comment { color: var(--text-faint); }
  .t-pass { color: var(--pass); font-weight: 500; }
  .t-warn { color: var(--warn); font-weight: 500; }
  .t-crit { color: var(--critical); font-weight: 500; }
  .t-info { color: var(--info); font-weight: 500; }

  @media (prefers-reduced-motion: reduce) {
    .term-line {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 48px 20px 40px;
    }
    .terminal-body {
      font-size: 0.72rem;
      padding: 14px 12px;
    }
  }
</style>

<script>
  const terminal = document.getElementById('hero-terminal');
  if (terminal) {
    const lines = terminal.querySelectorAll('.term-line');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      lines.forEach(l => l.classList.add('is-typed'));
    } else {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            lines.forEach(line => {
              const delay = parseInt(line.dataset.delay || '0', 10);
              setTimeout(() => line.classList.add('is-typed'), delay);
            });
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.3 });
      observer.observe(terminal);
    }
  }
</script>
