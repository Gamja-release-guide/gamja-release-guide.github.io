---
import type { Locale } from '../i18n/translations';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? 'en';
const isKo = locale === 'ko';

const rows = [
  {
    label: isKo ? '보안 스캔' : 'Security scanning',
    before: isKo ? '수동 리뷰에 의존' : 'Relies on manual review',
    after: isKo ? '40개 이상 체크 자동 실행' : '40+ checks run automatically',
  },
  {
    label: isKo ? '비용' : 'Cost',
    before: isKo ? '유료 SaaS 도구 필요' : 'Paid SaaS tools required',
    after: isKo ? '무료, 오픈소스' : 'Free, open source',
  },
  {
    label: isKo ? '설정 시간' : 'Setup time',
    before: isKo ? '시간~일 단위 (도구별 설정)' : 'Hours to days (per tool)',
    after: isKo ? '5분 (파일 복사)' : '5 minutes (copy files)',
  },
  {
    label: isKo ? '외부 의존성' : 'External deps',
    before: isKo ? '서드파티 서비스, API 키' : '3rd-party services, API keys',
    after: isKo ? '없음 (순수 bash)' : 'None (pure bash)',
  },
  {
    label: isKo ? '결과 확인' : 'Result visibility',
    before: isKo ? '별도 대시보드 확인' : 'Check separate dashboard',
    after: isKo ? 'PR 코멘트로 직접 표시' : 'Inline PR comments',
  },
  {
    label: isKo ? '커스터마이징' : 'Customization',
    before: isKo ? '도구 제한에 종속' : 'Limited by tool constraints',
    after: isKo ? '.yml 파일로 체크별 ON/OFF' : 'Per-check ON/OFF via .yml',
  },
];
---

<section class="comparison fade-in-section">
  <div class="comparison-inner">
    <h2 class="section-title">{isKo ? '왜 Release Guard인가?' : 'Why Release Guard?'}</h2>
    <p class="section-desc">{isKo ? '기존 방식과 비교해 보세요.' : 'Compare it to the alternatives.'}</p>
    <div class="table-wrap">
      <table class="cmp-table">
        <thead>
          <tr>
            <th class="cmp-th-label"></th>
            <th class="cmp-th-before">{isKo ? '기존 방식' : 'Without'}</th>
            <th class="cmp-th-after">{isKo ? 'Release Guard' : 'With Release Guard'}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <td class="cmp-label">{row.label}</td>
              <td class="cmp-before">
                <svg class="cmp-icon cmp-icon-x" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                {row.before}
              </td>
              <td class="cmp-after">
                <svg class="cmp-icon cmp-icon-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                {row.after}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="cmp-cards">
      {rows.map((row) => (
        <div class="cmp-card">
          <div class="cmp-card-label">{row.label}</div>
          <div class="cmp-card-row cmp-card-before">
            <svg class="cmp-icon cmp-icon-x" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            <span>{row.before}</span>
          </div>
          <div class="cmp-card-row cmp-card-after">
            <svg class="cmp-icon cmp-icon-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <span>{row.after}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .comparison {
    padding: 80px 24px;
  }

  .comparison-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .section-title {
    font-family: 'DM Sans', var(--font-sans);
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
    color: var(--text);
  }

  .section-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 32px;
    max-width: 560px;
  }

  .table-wrap {
    overflow-x: auto;
  }

  .cmp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }

  .cmp-table th {
    text-align: left;
    font-weight: 600;
    padding: 12px 16px;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    border-bottom: 2px solid var(--border);
  }

  .cmp-th-label {
    width: 150px;
    color: var(--text-faint);
  }

  .cmp-th-before {
    color: var(--text-muted);
  }

  .cmp-th-after {
    color: var(--accent);
  }

  .cmp-table tbody tr {
    transition: background 0.15s ease;
  }

  .cmp-table tbody tr:hover {
    background: var(--accent-light);
  }

  .cmp-table td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border-light);
    vertical-align: top;
  }

  .cmp-label {
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
  }

  .cmp-before {
    color: var(--text-muted);
  }

  .cmp-after {
    color: var(--text);
    font-weight: 500;
  }

  .cmp-icon {
    flex-shrink: 0;
    vertical-align: -2px;
    margin-right: 6px;
  }

  .cmp-icon-x {
    color: var(--critical);
    opacity: 0.7;
  }

  .cmp-icon-check {
    color: var(--pass);
  }

  .cmp-cards {
    display: none;
  }

  .cmp-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: border-color 0.15s ease;
  }

  .cmp-card:hover {
    border-color: var(--accent);
  }

  .cmp-card-label {
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--text);
  }

  .cmp-card-row {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .cmp-card-before {
    color: var(--text-muted);
  }

  .cmp-card-after {
    color: var(--text);
    font-weight: 500;
  }

  @media (max-width: 600px) {
    .comparison { padding: 48px 20px; }
    .table-wrap { display: none; }
    .cmp-cards {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
