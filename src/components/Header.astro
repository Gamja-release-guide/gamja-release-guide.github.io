---
import type { Locale } from '../i18n/translations';
import { t } from '../i18n/translations';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? 'en';
const i = t(locale);
---

<a href="#main-content" class="skip-nav">{locale === 'ko' ? '본문으로 건너뛰기' : 'Skip to content'}</a>
<header class="header">
  <div class="header-inner">
    <a href={locale === 'ko' ? '/ko/' : '/'} class="logo">
      <span class="logo-mark">RG</span>
      <span class="logo-text">Release Guard</span>
    </a>
    <nav class="nav">
      <a href="#output">{i.nav.output}</a>
      <a href="#features">{i.nav.features}</a>
      <a href="#playground">{i.nav.playground}</a>
      <a href="#roadmap">{i.nav.roadmap}</a>
      <a href={i.langSwitch.otherHref} class="nav-lang">{i.langSwitch.other}</a>
      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        aria-label={locale === 'ko' ? '테마 전환' : 'Toggle theme'}
      >
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
        </svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
        </svg>
      </button>
      <a href="https://github.com/Gamja-release-guide/release-guard" class="nav-github" target="_blank" rel="noopener">
        {i.nav.github}
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M3.75 2h3.5a.75.75 0 010 1.5H4.56l7.72 7.72a.75.75 0 11-1.06 1.06L3.5 4.56v2.69a.75.75 0 01-1.5 0v-3.5A1.75 1.75 0 013.75 2z"/>
        </svg>
      </a>
    </nav>
  </div>
</header>

<style>
  .skip-nav {
    position: absolute;
    top: -100%;
    left: 16px;
    z-index: 200;
    padding: 8px 16px;
    background: var(--accent);
    color: #fff;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    transition: top 0.15s;
  }

  .skip-nav:focus {
    top: 8px;
    text-decoration: none;
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-light);
  }

  .header-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text);
  }

  .logo-mark {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.82rem;
    background: var(--accent);
    color: #fff;
    padding: 3px 7px;
    border-radius: var(--radius-sm);
    letter-spacing: 0.04em;
  }

  .logo-text {
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav a {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .nav a:hover {
    color: var(--text);
    text-decoration: none;
  }

  .nav-lang {
    font-family: var(--font-mono);
    font-size: 0.78rem !important;
    font-weight: 500;
    padding: 3px 10px;
    border: 1px solid var(--border);
    border-radius: 4px;
    letter-spacing: 0.04em;
  }

  .nav-lang:hover {
    border-color: var(--accent);
    color: var(--accent) !important;
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    padding: 0;
  }

  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .theme-toggle .icon-moon {
    display: none;
  }

  :global([data-theme="dark"]) .theme-toggle .icon-sun {
    display: none;
  }

  :global([data-theme="dark"]) .theme-toggle .icon-moon {
    display: block;
  }

  .nav-github {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  @media (max-width: 600px) {
    .nav {
      gap: 12px;
    }
    .nav a:not(.nav-github):not(.nav-lang) {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('theme-toggle');
  const root = document.documentElement;

  function getTheme(): string {
    const stored = localStorage.getItem('theme');
    if (stored) return stored;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function applyTheme(theme: string) {
    root.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
  }

  applyTheme(getTheme());

  toggle?.addEventListener('click', () => {
    const current = root.getAttribute('data-theme');
    applyTheme(current === 'dark' ? 'light' : 'dark');
  });
</script>
