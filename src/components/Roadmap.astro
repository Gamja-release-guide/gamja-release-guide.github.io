---
import type { Locale } from '../i18n/translations';
import { t } from '../i18n/translations';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? 'en';
const i = t(locale);

const v2Features = [
  { name: 'Performance Check', desc: locale === 'ko' ? '번들 크기 추적, Lighthouse CI, 이미지 최적화 감지' : 'Bundle size tracking, Lighthouse CI, image optimization detection' },
  { name: 'API Contract Check', desc: locale === 'ko' ? 'OpenAPI 스펙 비교, GraphQL 스키마 호환성 검사' : 'OpenAPI spec diff, GraphQL schema breaking change detection' },
  { name: 'Accessibility Check', desc: locale === 'ko' ? '컴포넌트 코드의 WCAG 준수 패턴 검사' : 'WCAG compliance patterns in component code' },
  { name: 'Dependency License Audit', desc: locale === 'ko' ? 'SPDX 준수 기반 전이적 라이선스 심층 스캔' : 'Deep transitive license scanning with SPDX compliance' },
  { name: 'Config Drift Check', desc: locale === 'ko' ? 'staging/production 환경 설정 불일치 감지' : 'Detect env config mismatches across staging/production' },
  { name: 'Unified Dashboard', desc: locale === 'ko' ? '모든 체크의 주간/월간 종합 건강 보고서' : 'Aggregated weekly/monthly health report across all checks' },
  { name: 'Custom Check SDK', desc: locale === 'ko' ? '간단한 bash 템플릿으로 커스텀 체크 작성' : 'Write your own checks with a simple bash template' },
  { name: 'Monorepo Support', desc: locale === 'ko' ? 'Nx, Turborepo, Lerna 워크스페이스별 체크 범위 지정' : 'Per-package check scoping for Nx, Turborepo, Lerna workspaces' },
];
---

<section id="roadmap" class="roadmap fade-in-section">
  <div class="roadmap-inner">
    <h2 class="section-title">{i.roadmap.title}</h2>
    <p class="section-desc">{i.roadmap.desc}</p>

    <div class="roadmap-cols">
      <div class="roadmap-col">
        <div class="roadmap-col-header col-done">
          <span class="roadmap-col-dot dot-done"></span>
          {i.roadmap.v1Header}
        </div>
        <ul class="roadmap-list">
          {i.roadmap.v1Items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
      <div class="roadmap-col">
        <div class="roadmap-col-header col-next">
          <span class="roadmap-col-dot dot-next"></span>
          {i.roadmap.v2Header}
        </div>
        <ul class="roadmap-list">
          {v2Features.map((f) => (
            <li>
              <span class="v2-name">{f.name}</span>
              <span class="v2-desc">{f.desc}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .roadmap {
    padding: 80px 24px;
  }

  .roadmap-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .section-title {
    font-family: 'DM Sans', var(--font-sans);
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
    color: var(--text);
  }

  .section-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 32px;
  }

  .roadmap-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .roadmap-col {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .roadmap-col-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 18px;
    font-weight: 700;
    font-size: 0.88rem;
    border-bottom: 1px solid var(--border-light);
    color: var(--text);
  }

  .roadmap-col-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot-done { background: var(--pass); }
  .dot-next { background: var(--accent); }

  .roadmap-list {
    list-style: none;
    padding: 12px 18px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .roadmap-list li {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
    padding-left: 14px;
    position: relative;
  }

  .roadmap-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--border);
  }

  .col-done .roadmap-list li::before { background: var(--pass); }

  .v2-name {
    display: block;
    font-weight: 600;
    color: var(--text);
    font-size: 0.85rem;
  }

  .v2-desc {
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  @media (max-width: 600px) {
    .roadmap { padding: 48px 20px; }
    .roadmap-cols { grid-template-columns: 1fr; }
  }
</style>
