---
import type { Locale } from '../i18n/translations';
import { t } from '../i18n/translations';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? 'en';
const i = t(locale);
const isKo = locale === 'ko';
const configYml = `checks:
  secret-scan:
    enabled: true
  pr-size:
    enabled: true
    warn_lines: 300
    max_lines: 500
  xss-check:
    enabled: false`;
---

<section id="install" class="install fade-in-section">
  <div class="install-inner">
    <h2 class="section-title">{i.install.title}</h2>
    <p class="section-desc">{i.install.desc}</p>

    <div class="steps">
      <div class="step">
        <div class="step-num">1</div>
        <div class="step-content">
          <h3>{i.install.step1Title}</h3>
          <p>{i.install.step1Desc}</p>
          <div class="code-block">
            <div class="code-header">
              <span>Terminal</span>
              <button class="copy-btn" data-copy="curl -fsSL https://raw.githubusercontent.com/Gamja-release-guide/release-guard/main/install.sh | bash" aria-label="{isKo ? '복사' : 'Copy'}">
                <svg class="icon-copy" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                <svg class="icon-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" hidden><polyline points="20 6 9 17 4 12"/></svg>
              </button>
            </div>
            <pre><code>curl -fsSL https://raw.githubusercontent.com/Gamja-release-guide/release-guard/main/install.sh | bash</code></pre>
          </div>
        </div>
      </div>

      <div class="step">
        <div class="step-num">2</div>
        <div class="step-content">
          <h3>{i.install.step2Title}</h3>
          <p>{i.install.step2Desc}</p>
          <div class="code-block">
            <div class="code-header">
              <span>.release-guard.yml</span>
              <button class="copy-btn" data-copy={configYml} aria-label={isKo ? '복사' : 'Copy'}>
                <svg class="icon-copy" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                <svg class="icon-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" hidden><polyline points="20 6 9 17 4 12"/></svg>
              </button>
            </div>
            <pre><code><span class="c-key">checks</span>:
  <span class="c-key">secret-scan</span>:
    <span class="c-key">enabled</span>: <span class="c-val">true</span>
  <span class="c-key">pr-size</span>:
    <span class="c-key">enabled</span>: <span class="c-val">true</span>
    <span class="c-key">warn_lines</span>: <span class="c-num">300</span>
    <span class="c-key">max_lines</span>: <span class="c-num">500</span>
  <span class="c-key">xss-check</span>:
    <span class="c-key">enabled</span>: <span class="c-val">false</span></code></pre>
          </div>
        </div>
      </div>

      <div class="step">
        <div class="step-num">3</div>
        <div class="step-content">
          <h3>{i.install.step3Title}</h3>
          <p>{i.install.step3Desc}</p>
          <div class="result-preview">
            <div class="result-item result-pass">
              <span class="result-badge badge-pass">PASS</span>
              <span>secret-scan -- No secrets detected</span>
            </div>
            <div class="result-item result-warn">
              <span class="result-badge badge-warn">WARN</span>
              <span>pr-size-check -- Large PR (487 lines changed)</span>
            </div>
            <div class="result-item result-crit">
              <span class="result-badge badge-crit">CRITICAL</span>
              <span>xss-check -- dangerouslySetInnerHTML found</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .install {
    padding: 80px 24px;
    background: var(--surface);
  }

  .install-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .section-title {
    font-family: 'DM Sans', var(--font-sans);
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin-bottom: 8px;
    color: var(--text);
  }

  .section-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 40px;
    max-width: 560px;
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .step {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 16px;
  }

  .step-num {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--accent);
    background: var(--accent-light);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .step-content h3 {
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 6px;
    color: var(--text);
  }

  .step-content p {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 14px;
    line-height: 1.6;
  }

  .step-content code {
    font-family: var(--font-mono);
    font-size: 0.82em;
    background: var(--code-bg);
    color: var(--code-text);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }

  .code-block {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .code-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 14px;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-faint);
    background: var(--surface);
    border-bottom: 1px solid var(--border-light);
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: none;
    background: transparent;
    color: var(--text-faint);
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: color 0.15s, background 0.15s;
  }

  .copy-btn:hover {
    color: var(--text);
    background: var(--border-light);
  }

  .copy-btn.copied {
    color: var(--pass);
  }

  .code-block pre {
    margin: 0;
    padding: 14px 16px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--text);
  }

  .code-block pre code {
    background: none;
    padding: 0;
    font-size: inherit;
    color: inherit;
  }

  .c-key { color: var(--accent); }
  .c-val { color: var(--pass); }
  .c-num { color: var(--warn); }

  .result-preview {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .result-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: var(--bg-elevated);
    border-radius: var(--radius-sm);
    font-size: 0.82rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    border: 1px solid var(--border-light);
  }

  .result-badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 3px;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .badge-pass { background: var(--pass-bg); color: var(--pass); }
  .badge-warn { background: var(--warn-bg); color: var(--warn); }
  .badge-crit { background: var(--critical-bg); color: var(--critical); }

  @media (max-width: 600px) {
    .install { padding: 48px 20px; }
    .step { grid-template-columns: 30px 1fr; gap: 12px; }
    .step-num { width: 30px; height: 30px; font-size: 0.78rem; }
  }
</style>

<script>
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy');
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const iconCopy = btn.querySelector('.icon-copy');
        const iconCheck = btn.querySelector('.icon-check');
        if (iconCopy) iconCopy.setAttribute('hidden', '');
        if (iconCheck) iconCheck.removeAttribute('hidden');
        btn.classList.add('copied');
        setTimeout(() => {
          if (iconCopy) iconCopy.removeAttribute('hidden');
          if (iconCheck) iconCheck.setAttribute('hidden', '');
          btn.classList.remove('copied');
        }, 2000);
      } catch {}
    });
  });
</script>
